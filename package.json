{
  "name": "siteless",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:unit": "vitest run tests/unit",
    "test:db": "vitest run --config vitest.db.config.ts --pool=forks",
    "test:e2e": "playwright test",
    "verify": "pnpm typecheck && pnpm lint && pnpm test:unit && pnpm test:db && pnpm build",
    "db:generate": "tsx scripts/db.ts generate",
    "db:custom": "tsx scripts/db.ts custom",
    "db:migrate": "tsx scripts/db.ts migrate --target=test",
    "db:migrate:prod": "tsx scripts/db.ts migrate --target=prod",
    "db:check": "tsx scripts/check-test-db.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "7.9.4",
    "@date-fns/tz": "1.5.0",
    "@tailwindcss/postcss": "4.3.3",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.3.2",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.47.0",
    "motion": "13.4.0",
    "next": "16.3.5",
    "next-themes": "0.4.6",
    "postgres": "3.4.9",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "shadcn": "4.21.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "vaul": "1.1.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@clerk/testing": "2.2.36",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.1",
    "drizzle-kit": "0.31.10",
    "eslint": "10.11.0",
    "pg": "8.23.0",
    "prettier": "3.9.8",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
