{
  "name": "siteless",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:unit": "vitest run tests/unit",
    "test:db": "vitest run --config vitest.db.config.ts --pool=forks",
    "test:workflow": "vitest run --config vitest.workflow.config.ts",
    "test:e2e": "playwright test",
    "verify": "pnpm typecheck && pnpm lint && pnpm test:unit && pnpm test:db && pnpm test:workflow && pnpm build",
    "db:generate": "tsx scripts/db.ts generate",
    "db:custom": "tsx scripts/db.ts custom",
    "db:migrate": "tsx scripts/db.ts migrate --target=test",
    "db:migrate:prod": "tsx scripts/db.ts migrate --target=prod",
    "db:seed": "tsx scripts/seed.ts --target=test",
    "db:seed:prod": "tsx scripts/seed.ts --target=prod",
    "refresh:outlet-counts": "tsx scripts/refresh-outlet-counts.ts",
    "db:check": "tsx scripts/check-test-db.ts",
    "ingest:comptroller": "tsx scripts/ingest-comptroller.ts",
    "ingest:overture": "tsx scripts/ingest-overture.ts",
    "resolve": "tsx scripts/resolve.ts",
    "rederive": "tsx scripts/rederive.ts",
    "purge:places": "tsx scripts/purge-places.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "7.9.4",
    "@date-fns/tz": "1.5.0",
    "@tailwindcss/postcss": "4.3.3",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.3.2",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.2",
    "libphonenumber-js": "1.13.13",
    "lucide-react": "1.47.0",
    "motion": "13.4.0",
    "next": "16.3.5",
    "next-themes": "0.4.6",
    "postgres": "3.4.9",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "shadcn": "4.21.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "vaul": "1.1.2",
    "workflow": "4.8.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@clerk/testing": "2.2.36",
    "@duckdb/node-api": "1.5.5-r.5",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@workflow/vitest": "4.0.25",
    "dotenv": "18.0.1",
    "drizzle-kit": "0.31.10",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.1",
    "msw": "2.15.0",
    "pg": "8.23.0",
    "prettier": "3.9.8",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
