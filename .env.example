# Siteless — environment variable NAMES. Copy to .env.local and fill in.
# .env.local is gitignored. Never commit a value.

# --- Clerk (dev instance: equipped-newt-5148.clerk.accounts.dev) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=
CLERK_FRONTEND_API_URL=
CLERK_JWKS_URL=

# --- Supabase project `siteless` (ref jahgeqshuesndyscnmjo) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Migrations ONLY. Shared pooler, SESSION mode, port 5432, user postgres.jahgeqshuesndyscnmjo.
# Used by `pnpm db:migrate:prod`. Never by the runtime, never by a test.
# Do NOT use the direct db.<ref>.supabase.co:5432 address — it is IPv6-only without the
# IPv4 add-on and GitHub-hosted runners have no IPv6.
SUPABASE_DB_URL=

# Runtime ONLY. Production: shared pooler, TRANSACTION mode, port 6543, user
# app_user.jahgeqshuesndyscnmjo, driver opens with prepare:false.
# Locally: point it at the local Postgres as app_user —
#   postgres://app_user:app_user@localhost:5432/siteless_test
SUPABASE_DB_POOL_URL=

# Tests and local migrations ONLY. Local PostgreSQL 18, as the owner role.
# 🔴 NEVER a *.supabase.co / *.supabase.com / *.pooler.supabase.com host. D-04.
TEST_DATABASE_URL=

# --- Places (Phase 4) ---
# off | ids_only | enterprise — D-02; production stays off until the PROJECT.md legal decision.
# Unset or empty means off; any other value fails the boot parse in src/env.ts.
PLACES_MODE=off
# Server-only, API-restricted to Places API (New); never NEXT_PUBLIC_; read only by
# src/lib/places/client.ts (D-03 — deliberately NOT declared in src/env.ts).
GOOGLE_PLACES_API_KEY=
# ≥16 chars; Vercel sends it as a Bearer token to /api/cron/purge-places.
# Unset means the route refuses every request.
CRON_SECRET=

# Playwright (plan 03 / plan 11)
E2E_BASE_URL=
E2E_ADMIN_EMAIL=
CLERK_TESTING_TOKEN=
